# Finn - API Keys and Configuration
# Copy this file to .env and fill in your keys

# Required for self-evolution (strategy rewriting)
ANTHROPIC_API_KEY=

# Optional - Reddit API (for social sentiment)
# Get these at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=finn-financial-agent/0.1

# Optional - News API (fallback, RSS feeds work without key)
NEWS_API_KEY=

# Optional - Alpha Vantage (fallback, yfinance works without key)
ALPHA_VANTAGE_API_KEY=

# Agent settings
FINN_WATCHLIST=AAPL,MSFT,GOOGL,AMZN,NVDA,META,TSLA,JPM,V,JNJ,WMT,PG,UNH,HD,MA
FINN_DATA_DIR=./data
FINN_LOG_LEVEL=INFO
FINN_EVOLUTION_MIN_DAYS=7
FINN_MAX_PICKS_PER_DAY=5
